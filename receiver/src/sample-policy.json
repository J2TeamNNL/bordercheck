{
  "report": {
    "interval": "24h",
    "include_evidence": false,
    "include_ips": false,
    "fix_prompt": true
  },
  "update": {
    "binary": true,
    "interval": "24h"
  },
  "notify": {
    "enabled": true,
    "statuses": ["fail"],
    "severities": ["high", "medium"],
    "remind_every": "24h",
    "open_report": true
  },
  "checks": {
    "firewall": { "require_stealth": true },
    "disk-encryption": {},
    "listeners": {
      "on_problem": "warn",
      "allow": [{ "process": "rapportd" }]
    },
    "tailscale": {},
    "docker": { "allow_containers": [], "allow_mounts": [] },
    "secrets": {
      "production_keywords": ["prod", "production", "live"],
      "show_tail": true,
      "walk_depth": 5,
      "ignore_paths": [],
      "user_ignore": true,
      "sample_rules": ["git-tracked", "sdk", "sample-dir"]
    },
    "ssh-keys": {
      "no_passphrase": true,
      "loose_permissions": true,
      "authorized_keys": true,
      "allow_keys": [],
      "user_ignore": true
    },
    "tunnels": {
      "processes": true,
      "tailscale_funnel": true,
      "tailscale_serve": true,
      "allow": [],
      "lower_severity": ["cloudflared"]
    },
    "ai-agents": { "tokens": true, "guardrails": true, "user_ignore": true },
    "os-updates": {
      "min_os_versions": { "macos": "15", "windows": "26100", "ubuntu": "22.04" },
      "require_auto_update": true,
      "max_check_age_days": 14,
      "max_pending_days": 14,
      "max_days_since_update": 45,
      "check_browsers": true,
      "max_browser_age_days": 60
    },
    "screen-lock": { "require_password": true, "max_lock_minutes": 10 },
    "remote-access": { "allow": ["guest"] },
    "admin-rights": { "allow_admin": false },
    "os-protections": { "sip": true, "gatekeeper": true, "antivirus": true, "smartscreen": true, "secure_boot": true, "lsm": true },
    "sharing": { "allow": [] },
    "extensions": { "browsers": true, "editors": true, "block": [], "allow": [], "warn_all_sites": false },
    "browser-passwords": { "allow_browsers": [] },
    "trust-store": { "cas": true, "proxies": true, "allow_cas": [], "allow_proxies": [], "ca_severity": "medium" },
    "package-managers": { "require_ignore_scripts": true, "require_release_age": false, "allow_hosts": [] },
    "startup-items": { "allow": [], "extra_suspicious_paths": [] },
    "backup": { "require_backup": false, "require_encrypted": true, "require_find_my": true, "max_backup_age_days": 0 }
  }
}
