{
  "name": "Example Org",
  "report": {
    "url": "https://bordercheck.example.com/report",
    "headers": {
      "Authorization": "Bearer <report-submit-token>"
    },
    "interval": "24h",
    "include_evidence": false,
    "email_domains": [
      "example.com"
    ]
  },
  "update": {
    "binary": true,
    "policy_url": "https://bordercheck.example.com/policies.json",
    "interval": "24h",
    "repo": "ptrinh/bordercheck",
    "public_key": ""
  },
  "checks": {
    "firewall": {
      "require_stealth": true
    },
    "disk-encryption": {},
    "listeners": {
      "allow": [
        {
          "process": "rapportd"
        },
        {
          "process": "ControlCenter",
          "port": "7000"
        }
      ]
    },
    "tailscale": {},
    "docker": {
      "allow_containers": [],
      "allow_mounts": []
    },
    "secrets": {
      "extra_files": [],
      "ignore_paths": [
        "~/**/test-fixtures/**"
      ],
      "production_keywords": [
        "prod",
        "production",
        "live"
      ],
      "show_tail": true,
      "walk_depth": 5,
      "extra_patterns": [
        {
          "kind": "Example internal token",
          "regex": "\\bexo_[A-Za-z0-9]{32}\\b",
          "high": true,
          "show_tail": true
        }
      ],
      "locations": {
        "docker": true,
        "kube": true,
        "netrc": true,
        "git_credentials": true,
        "gcloud": true,
        "azure": true,
        "pypirc": true,
        "gh": true,
        "terraform": true,
        "pgpass": true,
        "mysql": true
      }
    },
    "ssh-keys": {
      "no_passphrase": true,
      "loose_permissions": true,
      "authorized_keys": true,
      "allow_keys": []
    },
    "tunnels": {
      "processes": true,
      "tailscale_funnel": true,
      "tailscale_serve": true,
      "allow": [],
      "lower_severity": [
        "cloudflared"
      ]
    },
    "ai-agents": {
      "tokens": true,
      "guardrails": true,
      "extra_paths": [],
      "ignore_paths": []
    }
  }
}
