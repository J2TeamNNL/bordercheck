{
  "name": "Example Org",
  "report": {
    "url": "https://bordercheck.example.com/report",
    "headers": {
      "Authorization": "Bearer <report-submit-token>"
    },
    "interval": "24h",
    "check_interval": "",
    "include_evidence": false,
    "email_domains": [
      "example.com"
    ],
    "include_ips": false,
    "include_location": false
  },
  "update": {
    "binary": true,
    "policy_url": "https://bordercheck.example.com/policies.json",
    "interval": "24h",
    "repo": "ptrinh/bordercheck",
    "public_key": ""
  },
  "notify": {
    "enabled": true,
    "statuses": [
      "fail"
    ],
    "severities": [
      "high",
      "medium"
    ],
    "remind_every": "24h",
    "open_report": true
  },
  "waivers": [
    {
      "check": "listeners",
      "email": "dev@example.com",
      "hostname": "dev-mbp",
      "until": "2026-12-01",
      "reason": "Postgres on 5432 for the data migration; ticket IT-123"
    }
  ],
  "checks": {
    "firewall": {
      "require_stealth": true,
      "suggest_outbound": true
    },
    "disk-encryption": {},
    "listeners": {
      "allow": [
        {
          "process": "rapportd"
        },
        {
          "process": "ControlCenter",
          "port": "7000"
        }
      ]
    },
    "tailscale": {},
    "docker": {
      "allow_containers": [],
      "allow_mounts": []
    },
    "secrets": {
      "extra_files": [],
      "ignore_paths": [
        "~/**/test-fixtures/**"
      ],
      "production_keywords": [
        "prod",
        "production",
        "live"
      ],
      "show_tail": true,
      "walk_depth": 5,
      "extra_patterns": [
        {
          "kind": "Example internal token",
          "regex": "\\bexo_[A-Za-z0-9]{32}\\b",
          "high": true,
          "show_tail": true
        }
      ],
      "locations": {
        "docker": true,
        "kube": true,
        "netrc": true,
        "git_credentials": true,
        "gcloud": true,
        "azure": true,
        "pypirc": true,
        "gh": true,
        "terraform": true,
        "pgpass": true,
        "mysql": true
      }
    },
    "ssh-keys": {
      "no_passphrase": true,
      "loose_permissions": true,
      "authorized_keys": true,
      "allow_keys": []
    },
    "tunnels": {
      "processes": true,
      "tailscale_funnel": true,
      "tailscale_serve": true,
      "allow": [],
      "lower_severity": [
        "cloudflared"
      ]
    },
    "os-updates": {
      "min_os_versions": {
        "macos": "15",
        "windows": "26100",
        "ubuntu": "22.04",
        "debian": "12",
        "fedora": "43"
      },
      "require_auto_update": true,
      "max_check_age_days": 14,
      "max_pending_days": 14,
      "max_days_since_update": 45,
      "check_browsers": true,
      "max_browser_age_days": 60,
      "min_browser_versions": {}
    },
    "screen-lock": {
      "require_password": true,
      "max_lock_minutes": 10
    },
    "remote-access": {
      "allow": []
    },
    "ai-agents": {
      "tokens": true,
      "guardrails": true,
      "extra_paths": [],
      "ignore_paths": []
    },
    "cracked-software": {
      "suggest_alternatives": true
    }
  }
}
