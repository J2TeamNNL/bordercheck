{
  "name": "Example Org",
  "report": {
    "url": "https://bordercheck.example.com/report",
    "headers": {
      "Authorization": "Bearer <report-submit-token>"
    },
    "interval": "24h",
    "include_evidence": false,
    "email_domains": [
      "example.com"
    ]
  },
  "update": {
    "binary": true,
    "policy_url": "https://bordercheck.example.com/policies.json",
    "interval": "24h",
    "repo": "ptrinh/bordercheck",
    "public_key": ""
  },
  "checks": {
    "firewall": {
      "require_stealth": true
    },
    "disk-encryption": {},
    "listeners": {
      "allow": [
        {
          "process": "rapportd"
        },
        {
          "process": "ControlCenter",
          "port": "7000"
        }
      ]
    },
    "tailscale": {},
    "docker": {
      "allow_containers": [],
      "allow_mounts": []
    },
    "secrets": {
      "extra_files": [],
      "ignore_paths": [
        "~/**/test-fixtures/**"
      ],
      "production_keywords": [
        "prod",
        "production",
        "live"
      ],
      "show_tail": true,
      "walk_depth": 5,
      "extra_patterns": [
        {
          "kind": "Example internal token",
          "regex": "\\bexo_[A-Za-z0-9]{32}\\b",
          "high": true,
          "show_tail": true
        }
      ]
    },
    "os-updates": {
      "min_os_versions": {
        "macos": "15",
        "windows": "26100",
        "ubuntu": "22.04",
        "debian": "12",
        "fedora": "43"
      },
      "require_auto_update": true,
      "max_check_age_days": 14,
      "max_pending_days": 14,
      "max_days_since_update": 45,
      "check_browsers": true,
      "max_browser_age_days": 60,
      "min_browser_versions": {}
    },
    "screen-lock": {
      "require_password": true,
      "max_lock_minutes": 10
    },
    "remote-access": {
      "allow": []
    }
  }
}
